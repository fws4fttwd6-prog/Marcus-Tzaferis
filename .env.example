# ── Required for live search ────────────────────────────────────────────────
# Without this, Krasi Crazy runs on bundled sample data and says so.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional ────────────────────────────────────────────────────────────────
PORT=3000
KRASI_MODEL=claude-opus-5

# Force sample data even when a key is present.
KRASI_DEMO=0

# Where the watchlist file lives. Defaults to ./data
# KRASI_DATA_DIR=/Users/you/krasi-data

# POST alerts somewhere when they fire. Any endpoint taking JSON works;
# Slack and Discord webhooks both read the `text` field.
# KRASI_WEBHOOK_URL=https://hooks.slack.com/services/...

# Background checker (npm run watch:daemon)
# KRASI_DAEMON_WAKE_MINUTES=30
# KRASI_DAEMON_MAX_PER_RUN=10

# Pin an exchange rate by hand, overriding the live feed.
# Value is Canadian dollars per one unit of that currency.
# KRASI_FX_EUR_CAD=1.6063
